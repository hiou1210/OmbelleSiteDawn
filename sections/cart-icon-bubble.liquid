{%- comment -%} Les lignes enfants (ajout d'un vase) ne comptent pas dans la pastille. {%- endcomment -%}
{%- liquid
  assign parent_item_count = 0
  for cart_item in cart.items
    if cart_item.parent_relationship == blank
      assign parent_item_count = parent_item_count | plus: cart_item.quantity
    endif
  endfor
-%}
{% if cart == empty %}
  <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
{% else %}
  <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
{% endif %}

<span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
{%- if cart != empty -%}
  <div class="cart-count-bubble">
    {%- if parent_item_count < 100 -%}
      <span aria-hidden="true">{{ parent_item_count }}</span>
    {%- endif -%}
    <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: parent_item_count }}</span>
  </div>
{%- endif -%}
