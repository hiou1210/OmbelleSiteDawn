{{ 'section-article-blocks.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #WrappedText-{{ section.id }} {
    --wrapped-image-width: {{ section.settings.image_width }}px;
  }
{%- endstyle -%}

{%- liquid
  assign show_conseil_box = false
  if section.settings.show_conseil
    if section.settings.conseil_title != blank or section.settings.conseil_text != blank
      assign show_conseil_box = true
    endif
  endif
-%}

{%- capture conseil_markup -%}
  {%- if show_conseil_box -%}
    <aside class="conseil-box gradient color-{{ section.settings.conseil_color_scheme }}">
      <span class="conseil-box__icon" aria-hidden="true">💡</span>
      <div class="conseil-box__content">
        {%- if section.settings.conseil_title != blank -%}
          <h3 class="conseil-box__title h4">{{ section.settings.conseil_title | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.conseil_text != blank -%}
          <div class="rte">{{ section.settings.conseil_text }}</div>
        {%- endif -%}
      </div>
    </aside>
  {%- endif -%}
{%- endcapture -%}

<div id="WrappedText-{{ section.id }}" class="wrapped-text gradient color-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    <div class="wrapped-text__content wrapped-text__content--image-{{ section.settings.image_position }}">
      {%- if section.settings.image != blank -%}
        <div class="wrapped-text__media">
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 750px) 400px, 100vw',
              widths: '375, 550, 750, 1100',
              alt: section.settings.image.alt
          }}
        </div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <{{ section.settings.heading_level }} class="wrapped-text__title h2">
          {{- section.settings.title | escape -}}
        </{{ section.settings.heading_level }}>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        {%- assign text_parts = section.settings.text | split: '[CONSEIL]' -%}
        <div class="wrapped-text__text rte">
          {%- if text_parts.size > 1 -%}
            {{ text_parts[0] }}
            {{ conseil_markup }}
            {{ text_parts[1] }}
          {%- else -%}
            {{ section.settings.text }}
          {%- endif -%}
        </div>
        {%- if text_parts.size <= 1 -%}
          {{ conseil_markup }}
        {%- endif -%}
      {%- else -%}
        {{ conseil_markup }}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Texte avec image intégrée",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Votre titre"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Niveau du titre",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ],
      "default": "h2",
      "info": "Choisissez le niveau de titre HTML pour le référencement et la hiérarchie."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Ajoutez votre texte ici. Le texte contourne l'image automatiquement.</p>",
      "info": "Pour insérer la boîte de conseil au milieu du texte, ajoutez [CONSEIL] à l'endroit voulu."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Position de l'image",
      "options": [
        { "value": "left", "label": "Gauche" },
        { "value": "right", "label": "Droite" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Largeur de l'image",
      "default": 400
    },
    {
      "type": "header",
      "content": "Boîte de conseil"
    },
    {
      "type": "checkbox",
      "id": "show_conseil",
      "label": "Afficher la boîte de conseil",
      "default": false
    },
    {
      "type": "text",
      "id": "conseil_title",
      "label": "Titre du conseil",
      "default": "Conseil de fleuriste"
    },
    {
      "type": "richtext",
      "id": "conseil_text",
      "label": "Texte du conseil"
    },
    {
      "type": "color_scheme",
      "id": "conseil_color_scheme",
      "label": "Couleurs de la boîte de conseil",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Texte avec image intégrée"
    }
  ]
}
{% endschema %}
