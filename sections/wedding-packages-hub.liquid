{{ 'section-wedding.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #WeddingHub-{{ section.id }} {
    --hub-columns: {{ section.settings.columns_desktop }};
  }
{%- endstyle -%}

<div id="WeddingHub-{{ section.id }}" class="wedding-hub gradient color-{{ section.settings.color_scheme }}">
  <div class="page-width section-{{ section.id }}-padding">
    <ul class="wedding-hub__grid" role="list">
      {%- for block in section.blocks -%}
        <li
          class="wedding-hub__card gradient color-{{ section.settings.card_color_scheme }}"
          {{ block.shopify_attributes }}
        >
          <div class="wedding-hub__media">
            {%- if block.settings.image != blank -%}
              {%- capture card_image -%}
                {{
                  block.settings.image
                  | image_url: width: 1100
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 400px, (min-width: 750px) 50vw, 100vw',
                    widths: '375, 550, 750, 1100',
                    class: 'wedding-hub__image',
                    alt: block.settings.image.alt
                }}
              {%- endcapture -%}
              {%- if block.settings.button_link != blank -%}
                <a href="{{ block.settings.button_link }}" tabindex="-1" aria-hidden="true">{{ card_image }}</a>
              {%- else -%}
                {{ card_image }}
              {%- endif -%}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
            {%- endif -%}
          </div>
          <div class="wedding-hub__content">
            <div class="wedding-hub__main">
              {%- if block.settings.title != blank -%}
                <h3 class="wedding-hub__title font-script">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <div class="wedding-hub__description rte">{{ block.settings.description }}</div>
              {%- endif -%}
            </div>
            {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
              <a class="button button--primary" href="{{ block.settings.button_link }}">
                {{- block.settings.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Forfaits mariage",
  "tag": "section",
  "class": "section",
  "max_blocks": 15,
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Colonnes sur ordinateur",
      "default": 3
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Cartes",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "package_block",
      "name": "Forfait",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Poétique pastel"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "400 x 300 px recommandé"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texte du bouton",
          "default": "Voir le forfait"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Lien du bouton"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Forfaits mariage",
      "blocks": [
        { "type": "package_block" },
        { "type": "package_block" },
        { "type": "package_block" }
      ]
    }
  ]
}
{% endschema %}
