{{ 'section-article-blocks.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign retain_items = section.blocks | where: 'type', 'retain_item'
  assign style_cards = section.blocks | where: 'type', 'style_card'
-%}

<div class="article-intro gradient color-{{ section.settings.color_scheme }}">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="article-intro__layout">
      <div class="article-intro__main">
        {%- if section.settings.breadcrumb -%}
          <nav class="article-intro__breadcrumb" aria-label="{{ 'ombelle.article.breadcrumb_label' | t }}">
            <a href="{{ routes.root_url }}">{{ 'ombelle.article.home' | t }}</a>
            <span aria-hidden="true">&gt;</span>
            {%- if blog != blank -%}
              <a href="{{ blog.url }}">{{ blog.title | escape }}</a>
            {%- endif -%}
          </nav>
        {%- endif -%}

        {%- if section.settings.use_article_content and article.content != blank -%}
          <div class="article-intro__text rte">{{ article.content }}</div>
        {%- else -%}
          {%- if section.settings.intro_text != blank -%}
            <div class="article-intro__lead rte">{{ section.settings.intro_text }}</div>
          {%- endif -%}

          {%- if section.settings.conseil_title != blank or section.settings.conseil_text != blank -%}
            <aside class="conseil-box gradient color-{{ section.settings.conseil_color_scheme }}">
              <span class="conseil-box__icon" aria-hidden="true">💡</span>
              <div class="conseil-box__content">
                {%- if section.settings.conseil_title != blank -%}
                  <h3 class="conseil-box__title h4">{{ section.settings.conseil_title | escape }}</h3>
                {%- endif -%}
                {%- if section.settings.conseil_text != blank -%}
                  <div class="rte">{{ section.settings.conseil_text }}</div>
                {%- endif -%}
              </div>
            </aside>
          {%- endif -%}

          {%- if section.settings.main_text != blank -%}
            <div class="article-intro__text rte">{{ section.settings.main_text }}</div>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="article-intro__aside">
        {%- if section.settings.retain_title != blank or retain_items.size > 0 -%}
          <div class="retain-box gradient color-{{ section.settings.retain_color_scheme }}">
            {%- if section.settings.retain_title != blank -%}
              <h2 class="retain-box__title h3">{{ section.settings.retain_title | escape }}</h2>
            {%- endif -%}
            {%- if retain_items.size > 0 -%}
              <ul class="retain-box__list" role="list">
                {%- for block in retain_items -%}
                  <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if style_cards.size > 0 -%}
          <ul class="style-cards" role="list">
            {%- for block in style_cards -%}
              <li class="style-card" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 25vw, 50vw',
                      widths: '275, 375, 550, 800',
                      class: 'style-card__image',
                      alt: block.settings.image.alt
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg placeholder style-card__image' }}
                {%- endif -%}
                {%- if block.settings.label != blank -%}
                  <span class="style-card__label">
                    {%- if block.settings.icon != blank -%}
                      <span aria-hidden="true">{{ block.settings.icon }}</span>
                    {%- endif -%}
                    <span>{{ block.settings.label | escape }}</span>
                  </span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Article mariage - contenu",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Colonne de gauche"
    },
    {
      "type": "checkbox",
      "id": "breadcrumb",
      "label": "Afficher le fil d'Ariane",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "use_article_content",
      "label": "Utiliser le contenu de l'article",
      "info": "Affiche le contenu de l'article Shopify. Important pour le flux RSS.",
      "default": false
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Texte d'introduction",
      "info": "Ignoré si « Utiliser le contenu de l'article » est coché."
    },
    {
      "type": "richtext",
      "id": "main_text",
      "label": "Texte principal",
      "info": "Ignoré si « Utiliser le contenu de l'article » est coché."
    },
    {
      "type": "header",
      "content": "Boîte de conseil"
    },
    {
      "type": "text",
      "id": "conseil_title",
      "label": "Titre du conseil",
      "default": "Conseil de fleuriste"
    },
    {
      "type": "richtext",
      "id": "conseil_text",
      "label": "Texte du conseil"
    },
    {
      "type": "color_scheme",
      "id": "conseil_color_scheme",
      "label": "Couleurs de la boîte de conseil",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Colonne de droite"
    },
    {
      "type": "text",
      "id": "retain_title",
      "label": "Titre « À retenir »",
      "default": "À retenir"
    },
    {
      "type": "color_scheme",
      "id": "retain_color_scheme",
      "label": "Couleurs de la boîte « À retenir »",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "retain_item",
      "name": "Point « À retenir »",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte",
          "default": "<p>Point important à retenir</p>"
        }
      ]
    },
    {
      "type": "style_card",
      "name": "Carte de style",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Libellé",
          "default": "Champêtre"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icône (emoji ou texte)",
          "default": "🏡"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Article mariage - contenu",
      "blocks": [
        { "type": "retain_item" },
        { "type": "retain_item" },
        { "type": "retain_item" },
        { "type": "style_card" },
        { "type": "style_card" }
      ]
    }
  ]
}
{% endschema %}
