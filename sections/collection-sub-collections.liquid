{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  Sous-collections : le menu de navigation dont le nom correspond au handle de la collection courante
  fournit la liste des sous-collections à afficher.
{%- endcomment -%}
{%- assign sub_menu = linklists[collection.handle] -%}

{%- if sub_menu != blank and sub_menu.links.size > 0 -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="collection-list-wrapper page-width isolate no-heading section-{{ section.id }}-padding">
      <ul
        class="collection-list contains-card contains-card--collection{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--2-col-tablet-down"
        role="list"
      >
        {%- for link in sub_menu.links -%}
          {%- if link.type == 'collection_link' and link.object != blank -%}
            <li class="collection-list__item grid__item{% if link.object.featured_image == nil %} collection-list__item--no-media{% endif %}">
              {% render 'card-collection',
                card_collection: link.object,
                media_aspect_ratio: section.settings.image_ratio,
                columns: section.settings.columns_desktop
              %}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{%- if collection.products.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "itemListElement": [
        {%- for product in collection.products limit: 48 -%}
          {
            "@type": "ListItem",
            "position": {{ forloop.index | json }},
            "url": {{ product.url | prepend: shop.url | json }},
            "name": {{ product.title | strip_html | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Sous-collections",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Affiche les collections du menu de navigation portant le même nom (handle) que la collection courante."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Colonnes sur ordinateur",
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Format des images",
      "options": [
        { "value": "adapt", "label": "Adapter à l'image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Carré" }
      ],
      "default": "square"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Sous-collections"
    }
  ]
}
{% endschema %}
