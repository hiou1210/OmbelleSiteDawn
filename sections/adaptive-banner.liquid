{{ 'section-adaptive-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hide_section = false
  if section.settings.hide_without_image and section.settings.image == blank
    assign hide_section = true
  endif

  assign overlay_opacity = section.settings.image_overlay_opacity | divided_by: 100.0
  assign box_opacity = section.settings.box_opacity | divided_by: 100.0

  assign box_is_transparent = false
  if section.settings.show_text_box == false or section.settings.box_opacity == 0
    assign box_is_transparent = true
  endif

  assign has_content = false
  if section.settings.heading != blank or section.settings.subheading != blank or section.settings.button_label != blank or section.settings.button_label_2 != blank
    assign has_content = true
  endif

  assign image_loading = 'lazy'
  assign fetch_priority = 'auto'
  if section.index <= 2
    assign image_loading = 'eager'
  endif
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{%- if hide_section -%}
  {%- comment -%} Sans image, on garde seulement le titre h1 pour le référencement. {%- endcomment -%}
  {%- if section.settings.heading_is_h1 and section.settings.heading != blank -%}
    <h1 class="visually-hidden">{{ section.settings.heading }}</h1>
  {%- endif -%}
{%- else -%}
  <div
    class="adaptive-banner{% if section.settings.stack_on_mobile %} adaptive-banner--stack-mobile{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    style="--adaptive-overlay-opacity: {{ overlay_opacity }}; --adaptive-box-opacity: {{ box_opacity }};"
  >
    <div class="adaptive-banner__media{% if section.settings.image == blank %} placeholder{% endif %}">
      {%- if section.settings.image != blank -%}
        <picture class="adaptive-banner__picture">
          {%- if section.settings.mobile_image != blank -%}
            {%- assign mobile = section.settings.mobile_image -%}
            <source
              media="(max-width: 749px)"
              srcset="{{ mobile | image_url: width: 375 }} 375w, {{ mobile | image_url: width: 550 }} 550w, {{ mobile | image_url: width: 750 }} 750w, {{ mobile | image_url: width: 1100 }} 1100w, {{ mobile | image_url: width: 1500 }} 1500w"
              sizes="100vw"
              width="{{ mobile.width }}"
              height="{{ mobile.height }}"
            >
          {%- endif -%}
          {{
            section.settings.image
            | image_url: width: 3840
            | image_tag:
              class: 'adaptive-banner__image',
              loading: image_loading,
              fetchpriority: fetch_priority,
              sizes: '100vw',
              widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
          }}
        </picture>
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg adaptive-banner__placeholder' }}
      {%- endif -%}
      <div class="adaptive-banner__overlay"></div>
    </div>

    {%- if has_content -%}
      <div class="adaptive-banner__content adaptive-banner__content--{{ section.settings.box_align }} page-width">
        <div
          class="adaptive-banner__box content-container content-container--full-width-mobile color-{{ section.settings.color_scheme }} gradient adaptive-banner__box--text-{{ section.settings.text_alignment }} adaptive-banner__box--mobile-text-{{ section.settings.text_alignment_mobile }}{% if box_is_transparent %} adaptive-banner__box--transparent{% elsif section.settings.box_opacity < 100 %} adaptive-banner__box--translucent{% endif %}"
        >
          {%- if section.settings.heading != blank -%}
            {%- assign heading_tag = 'h2' -%}
            {%- if section.settings.heading_is_h1 -%}
              {%- assign heading_tag = 'h1' -%}
            {%- endif -%}
            <{{ heading_tag }} class="adaptive-banner__heading inline-richtext {{ section.settings.heading_size }}">
              {{ section.settings.heading }}
            </{{ heading_tag }}>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <div class="adaptive-banner__text rte {{ section.settings.subheading_style }}">
              <p>{{ section.settings.subheading }}</p>
            </div>
          {%- endif -%}
          {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
            <div
              class="adaptive-banner__buttons{% if section.settings.button_label != blank and section.settings.button_label_2 != blank %} adaptive-banner__buttons--multiple{% endif %}"
            >
              {%- if section.settings.button_label != blank -%}
                <a
                  {% if section.settings.link == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ section.settings.link }}"
                  {% endif %}
                  class="button {% if section.settings.button_style_secondary %}button--secondary{% else %}button--primary{% endif %}"
                >
                  {{- section.settings.button_label | escape -}}
                </a>
              {%- endif -%}
              {%- if section.settings.button_label_2 != blank -%}
                <a
                  {% if section.settings.link_2 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ section.settings.link_2 }}"
                  {% endif %}
                  class="button {% if section.settings.button_style_secondary_2 %}button--secondary{% else %}button--primary{% endif %}"
                >
                  {{- section.settings.button_label_2 | escape -}}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bannière image adaptative",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "L'image garde ses proportions et donne la hauteur de la bannière."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Image pour mobile",
      "info": "Remplace l'image principale sur les petits écrans."
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacité du voile sombre sur l'image",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "Placer le texte sous l'image sur mobile",
      "info": "Désactivé, le texte est superposé à l'image sur mobile, avec ou sans boîte selon le réglage « Afficher la boîte derrière le texte ».",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_without_image",
      "label": "Masquer la section si l'image est absente",
      "info": "Le titre de niveau 1 reste présent pour le référencement.",
      "default": false
    },
    {
      "type": "header",
      "content": "Texte"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Votre titre"
    },
    {
      "type": "checkbox",
      "id": "heading_is_h1",
      "label": "Utiliser un titre de niveau 1",
      "info": "À activer sur une seule section par page, pour le référencement.",
      "default": false
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.heading_size.label",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" },
        { "value": "hxl", "label": "t:sections.all.heading_size.options__4.label" },
        { "value": "hxxl", "label": "t:sections.all.heading_size.options__5.label" }
      ],
      "default": "h1"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Sous-titre"
    },
    {
      "type": "select",
      "id": "subheading_style",
      "label": "Style du sous-titre",
      "options": [
        { "value": "body", "label": "Texte" },
        { "value": "subtitle", "label": "Sous-titre" },
        { "value": "caption-with-letter-spacing", "label": "Majuscules" }
      ],
      "default": "body"
    },
    {
      "type": "header",
      "content": "Premier bouton"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "info": "Laisser vide pour masquer le bouton."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Lien du bouton"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "label": "Utiliser le style de contour",
      "default": false
    },
    {
      "type": "header",
      "content": "Deuxième bouton"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Texte du bouton",
      "info": "Laisser vide pour masquer le bouton."
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Lien du bouton"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary_2",
      "label": "Utiliser le style de contour",
      "default": false
    },
    {
      "type": "header",
      "content": "Boîte de texte"
    },
    {
      "type": "checkbox",
      "id": "show_text_box",
      "label": "Afficher la boîte derrière le texte",
      "default": true
    },
    {
      "type": "range",
      "id": "box_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacité de la boîte derrière le texte",
      "info": "0 % rend la boîte invisible. Ne s'applique pas quand le texte est sous l'image sur mobile.",
      "default": 100
    },
    {
      "type": "select",
      "id": "box_align",
      "label": "Position de la boîte sur l'image",
      "options": [
        { "value": "top-left", "label": "En haut à gauche" },
        { "value": "top-center", "label": "En haut au centre" },
        { "value": "top-right", "label": "En haut à droite" },
        { "value": "middle-left", "label": "Au milieu à gauche" },
        { "value": "middle-center", "label": "Au milieu au centre" },
        { "value": "middle-right", "label": "Au milieu à droite" },
        { "value": "bottom-left", "label": "En bas à gauche" },
        { "value": "bottom-center", "label": "En bas au centre" },
        { "value": "bottom-right", "label": "En bas à droite" }
      ],
      "default": "middle-center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignement du texte",
      "options": [
        { "value": "left", "label": "Gauche" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Droite" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Alignement du texte sur mobile",
      "options": [
        { "value": "left", "label": "Gauche" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Droite" }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Bannière image adaptative"
    }
  ]
}
{% endschema %}
