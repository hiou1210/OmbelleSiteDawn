{{ 'section-wedding.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #WeddingPackage-{{ section.id }} .wedding-package__image {
    border-radius: {{ section.settings.image_radius }}px;
  }
{%- endstyle -%}

{%- liquid
  assign show_box = false
  if section.blocks.size > 0 or section.settings.description != blank or section.settings.price != blank or section.settings.note != blank
    assign show_box = true
  endif
  if section.settings.button_label != blank and section.settings.button_link != blank
    assign show_box = true
  endif

  # Garde une hiérarchie de titres logique selon les titres présents.
  assign box_heading_tag = 'h4'
  if section.settings.title == blank and section.settings.subtitle == blank
    assign box_heading_tag = 'h2'
  elsif section.settings.subtitle == blank
    assign box_heading_tag = 'h3'
  endif
-%}

<div id="WeddingPackage-{{ section.id }}" class="wedding-package gradient color-{{ section.settings.color_scheme }}">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="wedding-package__layout{% if section.settings.text_position == 'right' %} wedding-package__layout--reverse{% endif %}">
      <div class="wedding-package__text">
        {%- if section.settings.title != blank -%}
          <h2 class="wedding-package__title font-script">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <h3 class="wedding-package__subtitle font-script">{{ section.settings.subtitle | escape }}</h3>
        {%- endif -%}

        {%- if show_box -%}
          <div class="wedding-package__box gradient color-{{ section.settings.box_color_scheme }}">
            {%- if section.settings.includes_title != blank -%}
              <{{ box_heading_tag }} class="wedding-package__box-title">
                {{- section.settings.includes_title | escape -}}
              </{{ box_heading_tag }}>
            {%- endif -%}

            {%- if section.settings.description != blank -%}
              <div class="wedding-package__description rte">{{ section.settings.description }}</div>
            {%- endif -%}

            {%- if section.blocks.size > 0 -%}
              <ul class="wedding-package__list" role="list">
                {%- for block in section.blocks -%}
                  {%- if block.settings.item_text != blank -%}
                    <li
                      data-icon="{{ block.settings.item_icon | default: section.settings.list_icon | escape }}"
                      {{ block.shopify_attributes }}
                    >
                      {{- block.settings.item_text | escape -}}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if section.settings.price != blank -%}
              <p class="wedding-package__price">{{ section.settings.price | escape }}</p>
            {%- endif -%}

            {%- if section.settings.note != blank -%}
              <div class="wedding-package__note rte">{{ section.settings.note }}</div>
            {%- endif -%}

            {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
              <a class="button button--primary wedding-package__button" href="{{ section.settings.button_link }}">
                {{- section.settings.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="wedding-package__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 990px) 560px, 100vw',
              widths: '375, 550, 750, 1100, 1600',
              class: 'wedding-package__image',
              alt: section.settings.image.alt
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Forfait mariage",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "text_position",
      "label": "Position du texte",
      "options": [
        { "value": "left", "label": "Gauche" },
        { "value": "right", "label": "Droite" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Forfait 2"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Poétique pastel"
    },
    {
      "type": "text",
      "id": "includes_title",
      "label": "Titre de la liste",
      "default": "Ce forfait comprend :"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "list_icon",
      "label": "Icône de liste par défaut",
      "default": "✿",
      "info": "Utilisée quand un élément n'a pas son propre symbole."
    },
    {
      "type": "text",
      "id": "price",
      "label": "Prix",
      "default": "À partir de 625 $ + taxes"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Note"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Voir plus de photos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "800 x 1000 px recommandé"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Arrondi de l'image",
      "default": 20
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "box_color_scheme",
      "label": "Boîte des inclusions",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "include_item",
      "name": "Élément inclus",
      "settings": [
        {
          "type": "text",
          "id": "item_text",
          "label": "Texte",
          "default": "1 bouquet de mariée"
        },
        {
          "type": "text",
          "id": "item_icon",
          "label": "Symbole",
          "info": "Laisser vide pour utiliser l'icône par défaut."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Forfait mariage",
      "blocks": [
        { "type": "include_item", "settings": { "item_text": "1 bouquet de mariée" } },
        { "type": "include_item", "settings": { "item_text": "3 bouquets de demoiselles d'honneur" } },
        { "type": "include_item", "settings": { "item_text": "3 boutonnières de garçons d'honneur" } },
        { "type": "include_item", "settings": { "item_text": "1 panier de pétales" } }
      ]
    }
  ]
}
{% endschema %}
