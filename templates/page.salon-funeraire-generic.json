          "settings": {
            "image": "shopify://shop_images/Testemonial-deuil_1f413cf7-76dc-4d00-ac70-71246d5aa66d.jpg",
            "mobile_image": "shopify://shop_images/Testemonial-deuil-mobile_38fdd179-7781-4cfc-b501-2a64de91ef60.jpg",
            "image_overlay_opacity": 40,
            "heading": "\"Je voulais prendre quelques minutes ce matin pour vous remercier pour la qualité de la corbeille funéraire que j’ai achetée chez vous samedi. Elle était magnifique. Cet arrangement floral était très important pour moi et je suis vraiment ravie d’avoir commandé chez vous.\"<br/>",
            "heading_size": "h2",
            "subheading": "Judith N.",
            "show_text_box": true,
            "box_align": "middle-center",
            "text_alignment": "center",
            "text_alignment_mobile": "center",
            "color_scheme": "scheme-4"
          }
        },
        "template--14929956503633__51d86d60-2883-4b90-bed4-f74be3eaf9c1-image-2": {
          "type": "slide",
          "settings": {
            "image": "shopify://shop_images/Testemonial-deuil_1f413cf7-76dc-4d00-ac70-71246d5aa66d.jpg",
            "mobile_image": "shopify://shop_images/Testemonial-deuil-mobile_38fdd179-7781-4cfc-b501-2a64de91ef60.jpg",
            "image_overlay_opacity": 40,
            "heading": "\"Wow et wow. Nous avons commandé un funéraire, il était encore plus beau que sur la photo, les fleurs superbes et le montage réalisé par une artiste. Très satisfaits, nous reviendrons assurément et vous ferons de la publicité. Merci mille fois.\"",
            "heading_size": "h2",
            "subheading": "Manon Tremblay",
            "show_text_box": true,
            "box_align": "middle-center",
            "text_alignment": "center",
            "text_alignment_mobile": "center",
            "color_scheme": "scheme-4"
