    "faq_ER7WpP": {
      "type": "faq",
      "blocks": {
        "content_UEbgKX": {
          "type": "question",
          "settings": {
            "question": "🌸 Les fleurs livrées à McMasterville sont-elles remises en main propre ?",
            "answer": "<p>Oui : notre boutique est sur le même boulevard Sir-Wilfrid-Laurier, à quelques minutes. Vos fleurs quittent notre chambre froide et vous sont remises directement par notre équipe, jamais laissées à la porte.</p>"
          }
        },
        "content_QEjQcz": {
          "type": "question",
          "settings": {
            "question": "🌸 Livrez-vous les arrangements directement au Salon funéraire Demers de McMasterville ?",
            "answer": "<p>Oui, par notre équipe, en coordination avec le salon (heure d'exposition, nom du défunt).</p>"
          }
        }
      },
