        "template--14812863103057__ccd90632-255f-487e-b8e8-f4d963eecf67-167456376728a170ee-0-text": {
          "type": "text",
          "settings": {
            "text": "<p><em>Ombelle Fleuriste</em> offre la livraison de fleurs fraîches, de plantes et de cadeaux dans les municipalités suivantes : <a href=\"/pages/fleuriste-beloeil\" title=\"Ombelle Fleuriste  |  Beloeil | Livraison de fleurs Beloeil\"><em><strong>Beloeil</strong></em></a>, <a href=\"/pages/fleuriste-boucherville\" title=\"Fleuriste Boucherville | Ombelle Fleuriste\"><em><strong>Boucherville</strong></em></a>, Brossard, <a href=\"/pages/fleuriste-carignan\" title=\"Fleuriste Carignan | Ombelle Fleuriste\"><em><strong>Carignan</strong></em></a>, <a href=\"/pages/fleuriste-chambly\" title=\"Fleuriste Chambly | Ombelle Fleuriste\"><em><strong>Chambly</strong></em></a>, Greenfield Park, <a href=\"/pages/fleuriste-longueuil\" title=\"Fleuriste Longueuil | Livraison de fleurs Longueuil\"><em><strong>Longueuil</strong></em></a>, <a href=\"/pages/fleuriste-mcmasterville\" title=\"Fleuriste McMasterville | Ombelle Fleuriste\"><em><strong>McMasterville</strong></em></a>, <a href=\"/pages/fleuriste-mont-saint-hilaire\" title=\"Ombelle Fleuriste  |  Mont-Saint-Hilaire | Livraison de fleurs Mont-Saint-Hilaire\"><em><strong>Mont-Saint-Hilaire</strong></em></a>, <a href=\"/pages/fleuriste-otterburn-park\" title=\"Fleuriste Otterburn Park | Ombelle Fleuriste\"><em><strong>Otterburn Park</strong></em></a>, Saint-Amable, <a href=\"/pages/fleuriste-saint-basile-le-grand\" title=\"Ombelle Fleuriste  |  Saint-Basile-le-Grand | Livraison de fleurs Saint-Basile-le-Grand\"><em><strong>Saint-Basile-le-Grand</strong></em></a>, <a href=\"/pages/fleuriste-saint-bruno-de-montarville\" title=\"Fleuriste Saint-Bruno-de-Montarville | Livraison Fleurs | Ombelle Fleuriste\"><em><strong>Saint-Bruno</strong></em><strong>-de-Montarville</strong></a>, Saint-Charles-sur-Richelieu, <a href=\"/pages/fleuriste-saint-hubert\" title=\"Fleuriste Saint-Hubert | Ombelle Fleuriste\"><em><strong>Saint-Hubert</strong></em></a>, <a href=\"/pages/fleuriste-saint-lambert\" title=\"Fleuriste Saint-Lambert | Ombelle Fleuriste\"><em><strong>Saint-Lambert</strong></em></a>, Saint-Mathieu-de-Beloeil, <a href=\"/pages/fleuriste-sainte-julie\" title=\"Ombelle Fleuriste  |  Sainte-Julie | Livraison de fleurs Sainte-Julie\"><em><strong>Sainte-Julie</strong></em></a> et Saint-Marc-sur-Richelieu.</p>",
            "text_style": "body"
          }
        }
      },
