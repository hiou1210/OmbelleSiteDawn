    "faca265b-9aa5-4d47-a033-a3ec55df1db9-1": {
      "type": "image-with-text",
      "blocks": {
        "template--14812863397969__faca265b-9aa5-4d47-a033-a3ec55df1db9-1674686499e11ed221-0-text": {
          "type": "text",
          "settings": {
            "text": "<p><a href=\"https://www.ombellefleuriste.ca\" title=\"https://www.ombellefleuriste.ca\"><em>Ombelle Fleuriste</em></a> offre un service rapide et efficace pour <strong>la livraison de fleurs fraîches</strong>, de plantes et de cadeaux à <strong>St-Hubert</strong>. Soyez assuré de la qualité de son service, de même que de l’écoute et de la courtoisie de son personnel.</p><p>Élégance et modernité caractérisent les <strong>bouquets</strong> et <strong>arrangements floraux</strong> confectionnés par l’équipe expérimentée d’Ombelle Fleuriste. Contemporains, européens, exotiques, classiques ou champêtres, tous les styles sont possibles grâce au vaste choix de fleurs et de feuillages que l’on retrouve en boutique.</p>",
            "text_style": "body"
          }
        }
      },
      "block_order": [
        "template--14812863397969__faca265b-9aa5-4d47-a033-a3ec55df1db9-1674686499e11ed221-0-text"
      ],
      "settings": {
        "image": "shopify://shop_images/Bouquet-de-roses-fleuriste-st-hubert.jpg",
        "height": "adapt",
        "desktop_image_width": "medium",
        "layout": "image_first",
        "desktop_content_position": "middle",
        "desktop_content_alignment": "left",
        "mobile_content_alignment": "left",
        "section_color_scheme": "scheme-1",
        "color_scheme": "scheme-1",
        "padding_top": 20,
