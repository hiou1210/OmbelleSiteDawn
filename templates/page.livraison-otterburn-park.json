    "490919c3-9ad5-43a0-986d-62c24a060a8e": {
      "type": "slideshow",
      "blocks": {
        "template--14815501975633__490919c3-9ad5-43a0-986d-62c24a060a8e-1675134710e5b073f1-0": {
          "type": "slide",
          "settings": {
            "image": "shopify://shop_images/livraison-fleurs-otterburn-park-testemonial.jpg",
            "mobile_image": "shopify://shop_images/livraison-fleurs-otterburn-park-testemonial-mobile.jpg",
            "image_overlay_opacity": 40,
            "heading": "\"Je recommande fortement ce fleuriste. Une belle équipe agréable. J’y vais régulièrement pour de petits bouquets ou des compositions qui embellissent la maison et qui rendent heureuse ma compagne.\"",
            "heading_size": "h2",
            "subheading": "Franz Vanoosthuyse",
            "show_text_box": true,
            "box_align": "middle-center",
            "text_alignment": "center",
            "text_alignment_mobile": "center",
            "color_scheme": "scheme-4"
          }
        },
        "template--14815501975633__490919c3-9ad5-43a0-986d-62c24a060a8e-1675134710e5b073f1-1": {
          "type": "slide",
          "settings": {
            "image": "shopify://shop_images/fleuriste-otterburn-park-testemonial2.jpg",
            "mobile_image": "shopify://shop_images/fleuriste-otterburn-park-testemonial2-mobile.jpg",
            "image_overlay_opacity": 40,
            "heading": "\"Commandé via leur boutique en ligne et demandé de faire livrer les fleurs deux jours plus tard dans l'après-midi. Ils ont confirmé le délai de livraison avant de passer. La commande a été simple, la livraison a été efficace et surtout les fleurs ont fière allure.\"",
            "heading_size": "h2",
            "subheading": "Olivier Kaija",
            "show_text_box": true,
            "box_align": "middle-center",
            "text_alignment": "center",
            "text_alignment_mobile": "center",
            "color_scheme": "scheme-4"
          }
        },
        "template--14815501975633__490919c3-9ad5-43a0-986d-62c24a060a8e-1675134710e5b073f1-2": {
          "type": "slide",
          "settings": {
            "image": "shopify://shop_images/fleuriste-otterburn-park-testemonial3.jpg",
            "mobile_image": "shopify://shop_images/fleuriste-otterburn-park-testemonial3-mobile.jpg",
            "image_overlay_opacity": 40,
            "heading": "\"Super service très humain! Bouquet magnifique, impeccable emballage pour la livraison, produits cadeaux succulents. Recommandes très fortement, je commanderais à nouveau sans hésitation :)\"",
            "heading_size": "h2",
            "subheading": "Marie Eve Bourassa",
            "show_text_box": true,
            "box_align": "middle-center",
            "text_alignment": "center",
            "text_alignment_mobile": "center",
            "color_scheme": "scheme-4"
          }
        }
