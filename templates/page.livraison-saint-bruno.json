    "eca569e5-003d-4474-8841-6018dba8df31": {
      "type": "slideshow",
      "blocks": {
        "template--14812863365201__eca569e5-003d-4474-8841-6018dba8df31-167459961635317287-0": {
          "type": "slide",
          "settings": {
            "image": "shopify://shop_images/livraison-fleurs-st-bruno-testemonial.jpg",
            "mobile_image": "shopify://shop_images/livraison-fleurs-st-bruno-testemonial-mobile.jpg",
            "image_overlay_opacity": 40,
            "heading": "\"Je recommande fortement ce fleuriste. Une belle équipe agréable. J’y vais régulièrement pour de petits bouquets ou des compositions qui embellissent la maison et qui rendent heureuse ma compagne.\"",
            "heading_size": "h2",
            "subheading": "Franz Vanoosthuyse",
            "show_text_box": true,
            "box_align": "middle-center",
            "text_alignment": "center",
            "text_alignment_mobile": "center",
            "color_scheme": "scheme-4"
          }
        },
        "template--14812863365201__eca569e5-003d-4474-8841-6018dba8df31-167459961635317287-1": {
          "type": "slide",
          "settings": {
            "image": "shopify://shop_images/fleuriste-st-bruno-testemonial2.jpg",
            "mobile_image": "shopify://shop_images/fleuriste-st-bruno-testemonial2-mobile.jpg",
            "image_overlay_opacity": 40,
            "heading": "\"Commandé via leur boutique en ligne et demandé de faire livrer les fleurs deux jours plus tard dans l'après-midi. Ils ont confirmé le délai de livraison avant de passer. La commande a été simple, la livraison a été efficace et surtout les fleurs ont fière allure.\"",
            "heading_size": "h2",
            "subheading": "Olivier Kaija",
            "show_text_box": true,
            "box_align": "middle-center",
            "text_alignment": "center",
            "text_alignment_mobile": "center",
            "color_scheme": "scheme-4"
          }
        },
        "template--14812863365201__eca569e5-003d-4474-8841-6018dba8df31-167459961635317287-2": {
          "type": "slide",
          "settings": {
            "image": "shopify://shop_images/fleuriste-saint-bruno-testemonial3.jpg",
            "mobile_image": "shopify://shop_images/fleuriste-saint-bruno-testemonial3-mobile.jpg",
            "image_overlay_opacity": 40,
