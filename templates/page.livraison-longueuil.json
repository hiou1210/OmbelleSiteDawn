    "3f07a0cf-54c1-4cad-b032-86cfb1240a3e-1": {
      "type": "image-with-text",
      "blocks": {
        "template--14812863266897__3f07a0cf-54c1-4cad-b032-86cfb1240a3e-1674614206e72a65f0-0-heading": {
